# snapi environment. Copy to .env (gitignored) and fill in; never commit real keys.
# app.py and `uv run python brokerage.py` load .env with python-dotenv.
# APP_PASSWORD is not here: it lives in .streamlit/secrets.toml as APP_PASSWORD = "..."
# (gitignored; on Streamlit Cloud it is the app's only secret).
# Never set LANGSMITH_TRACING or LANGCHAIN_TRACING_V2 (R12: tracing stays off).

# Model id; empty means claude-haiku-4-5-20251001 (dev). The demo uses claude-sonnet-5.
SNAPI_MODEL=
# Anthropic key for the five committee agents; without it Run swarm is disabled.
ANTHROPIC_API_KEY=

# SnapTrade Personal key (consumer key plus client id), for orders, positions and activity.
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_CLIENT_ID=
# Account ids, found with `uv run python brokerage.py`: Balanced's Alpaca Paper account
# and the read-only SnapTrade Sandbox account (demo holdings and activity).
SNAPTRADE_ALPACA_PAPER_ACCOUNT_ID=
SNAPTRADE_SANDBOX_ACCOUNT_ID=

# Alpha Vantage NEWS_SENTIMENT (free tier, 25 calls a day, cached daily).
ALPHAVANTAGE_API_KEY=
# Alpaca paper API keys, used only for the Alpaca News fallback.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# FRED macro series for the regime; needed by seeding, Run swarm, Rebalance and Reset books.
FRED_API_KEY=

# Hosted SnapTrade MCP for the chat tab (Phase5, laptop only; token minted by hand, R6).
SNAPTRADE_MCP_URL=
SNAPTRADE_MCP_OAUTH_TOKEN=
